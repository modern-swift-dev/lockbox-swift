---
const base = `${import.meta.env.BASE_URL}/`;
---
<footer class="mt-24 bg-slate-950 py-14 text-slate-300">
  <div class="page-shell grid gap-10 md:grid-cols-[1fr_auto] md:items-end">
    <div>
      <p class="text-xl font-bold text-white">Lockbox</p>
      <p class="mt-3 max-w-md leading-7">A Swift wrapper for Apple Keychain Services and Local Authentication, built for apps that need explicit, typed keychain operations.</p>
    </div>
    <nav class="flex flex-wrap gap-x-5 gap-y-3 text-sm font-semibold" aria-label="Footer navigation">
      <a class="hover:text-white" href={base}>Overview</a>
      <a class="hover:text-white" href={`${base}documentation/`}>Documentation</a>
      <a class="hover:text-white" href={`${base}examples/`}>Examples</a>
      <a class="hover:text-white" href="https://github.com/modern-swift-dev/lockbox-swift">GitHub</a>
    </nav>
  </div>
</footer>
