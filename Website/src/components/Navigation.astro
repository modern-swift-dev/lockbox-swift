---
const base = `${import.meta.env.BASE_URL}/`;
const currentPath = Astro.url.pathname;
const links = [
  ["Overview", base],
  ["Documentation", `${base}documentation/`],
  ["Examples", `${base}examples/`]
] as const;

function isCurrent(href: string): boolean {
  if (href === base) return currentPath === base;
  return currentPath.startsWith(href);
}
---
<header class="sticky top-0 z-40 border-b border-indigo-100/80 bg-white/90 backdrop-blur">
  <nav class="page-shell flex min-h-16 items-center justify-between gap-4" aria-label="Main navigation">
    <a class="flex items-center gap-2 text-lg font-bold text-ink no-underline" href={base} aria-label="Lockbox home">
      <span class="grid size-8 place-items-center rounded-xl bg-gradient-to-br from-indigo-600 to-violet-600 text-sm text-white">L</span> Lockbox
    </a>
    <div class="hidden items-center gap-1 sm:flex sm:gap-2">
      {links.map(([label, href]) => <a class="rounded-full px-3 py-2 text-sm font-semibold text-slate-600 no-underline transition hover:bg-indigo-50 hover:text-indigo-700 sm:px-4" href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
      <a class="rounded-full bg-indigo-600 px-4 py-2 text-sm font-semibold text-white no-underline transition hover:bg-indigo-700" href="https://github.com/modern-swift-dev/lockbox-swift">GitHub</a>
    </div>
    <details class="relative sm:hidden">
      <summary class="cursor-pointer list-none rounded-full border border-indigo-200 bg-white px-4 py-2 text-sm font-semibold text-indigo-700">Menu</summary>
      <div class="absolute right-0 mt-2 grid min-w-48 gap-1 rounded-2xl border border-indigo-100 bg-white p-2 shadow-xl">
        {links.map(([label, href]) => <a class="rounded-xl px-4 py-2 text-sm font-semibold text-slate-700 no-underline hover:bg-indigo-50 hover:text-indigo-700" href={href} aria-current={isCurrent(href) ? "page" : undefined}>{label}</a>)}
        <a class="rounded-xl px-4 py-2 text-sm font-semibold text-indigo-700 no-underline hover:bg-indigo-50" href="https://github.com/modern-swift-dev/lockbox-swift">GitHub</a>
      </div>
    </details>
  </nav>
</header>
