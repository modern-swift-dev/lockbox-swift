---
import type { Release } from "../lib/release";
interface Props { release: Release; }
const { release } = Astro.props;
const date = new Intl.DateTimeFormat("en", { day: "numeric", month: "long", year: "numeric", timeZone: "UTC" }).format(release.publishedAt);
---
<aside class="card p-6" aria-label="Latest release">
  <p class="text-sm font-bold tracking-[0.14em] text-indigo-600 uppercase">Latest release</p>
  <p class="mt-3 text-3xl font-bold text-ink">{release.version}</p>
  <p class="mt-2 text-sm leading-6 text-muted">Published {date}. Install version <code class="rounded bg-indigo-50 px-1.5 py-0.5 text-indigo-800">{release.version}</code>.</p>
  <a class="mt-5 inline-flex font-semibold text-indigo-700 hover:text-violet-700" href={release.notesURL}>Read release notes <span aria-hidden="true">→</span></a>
</aside>
