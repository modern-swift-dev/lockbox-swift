<div class="card overflow-hidden p-5 sm:p-7">
  <div class="flex items-center justify-between gap-4"><div><p class="text-sm font-bold text-ink">Save and update one keychain record</p><p class="mt-1 text-sm text-muted">The service and account identify the record. A later save replaces its secret.</p></div><span class="rounded-full bg-violet-100 px-3 py-1 text-xs font-bold text-violet-700">update</span></div>
  <div class="mt-6 grid gap-4 md:grid-cols-[1fr_auto_1fr] md:items-center">
    <section class="rounded-2xl border border-slate-200 bg-slate-50 p-4" aria-label="Stored keychain record before update"><p class="font-mono text-xs font-bold text-slate-500">STORED RECORD</p><dl class="mt-3 space-y-2 text-sm"><div class="flex justify-between gap-3"><dt class="text-muted">service</dt><dd class="font-mono text-ink">com.example.app</dd></div><div class="flex justify-between gap-3"><dt class="text-muted">account</dt><dd class="font-mono text-ink">ada@example.com</dd></div><div class="flex justify-between gap-3"><dt class="text-muted">secret</dt><dd class="font-mono text-ink">first-secret</dd></div></dl></section>
    <span class="mx-auto grid size-9 place-items-center rounded-full bg-indigo-600 font-bold text-white" aria-hidden="true">→</span>
    <section class="rounded-2xl border border-indigo-200 bg-indigo-50 p-4" aria-label="Stored keychain record after update"><p class="font-mono text-xs font-bold text-indigo-600">UPDATED RECORD</p><dl class="mt-3 space-y-2 text-sm"><div class="flex justify-between gap-3"><dt class="text-muted">service</dt><dd class="font-mono text-ink">com.example.app</dd></div><div class="flex justify-between gap-3"><dt class="text-muted">account</dt><dd class="font-mono text-ink">ada@example.com</dd></div><div class="flex justify-between gap-3"><dt class="text-muted">secret</dt><dd class="font-mono text-ink">replacement-secret</dd></div></dl></section>
  </div>
</div>
