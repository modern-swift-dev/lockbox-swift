---
import BaseLayout from "../../layouts/BaseLayout.astro";
import DocumentationCard from "../../components/DocumentationCard.astro";
const base = `${import.meta.env.BASE_URL}/`;
---
<BaseLayout title="Documentation | Lockbox" description="Guides and API documentation for Lockbox.">
  <section class="page-shell py-20 sm:py-28"><p class="eyebrow">Documentation</p><h1 class="section-title">Start with the API you need.</h1><p class="section-copy">The guides explain Lockbox-specific behavior. The DocC reference documents the public Lockbox symbols available in a macOS package build. The examples also cover the iOS-only biometric service.</p><div class="mt-12 grid gap-5 md:grid-cols-2"><DocumentationCard headingLevel="h2" symbol="01" title="Getting started" description="Install the package, save a password, read it, update it, and remove it." href={`${base}documentation/getting-started/`} /><DocumentationCard headingLevel="h2" symbol="API" title="Lockbox API reference" description="Browse generated DocC documentation for the public Lockbox module." href={`${base}documentation/lockbox/documentation/lockbox/`} /><DocumentationCard headingLevel="h2" symbol="G" title="Generic passwords" description="Use a service and account to store a string or raw data." href={`${base}examples/#generic-password`} /><DocumentationCard headingLevel="h2" symbol="I" title="Internet passwords" description="Save credentials that belong to a URL, protocol, and authentication type." href={`${base}examples/#internet-password`} /><DocumentationCard headingLevel="h2" symbol="Q" title="Keychain criteria" description="Build lower-level queries when the password factories do not express your operation." href={`${base}examples/#keychain-criteria`} /><DocumentationCard headingLevel="h2" symbol="B" title="Local authentication" description="Evaluate a policy and protect iOS credentials with biometrics." href={`${base}examples/#biometrics`} /></div></section>
</BaseLayout>
